(kitchen_site) {
  encode zstd gzip

  @root path /
  redir @root /vps-entry.html?release=86 302

  @freshFrontend path / /index.html /vps-entry.html /src/* /manifest.webmanifest /sw.js
  header @freshFrontend Cache-Control "no-store, no-cache, must-revalidate"

  @api path /api/*
  handle @api {
    reverse_proxy app:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

:80 {
  import kitchen_site
}

82.47.180.185.nip.io {
  import kitchen_site
}
