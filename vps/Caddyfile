(kitchen_site) {
  encode zstd gzip

  # The application has one canonical entry point. Old bookmarks continue to
  # work and keep their hash route, but the browser address becomes "/".
  @legacyEntry path /vps-entry.html
  redir @legacyEntry / 308

  # Super Admin has a dedicated non-navigation entry. Keep the former URL only
  # as a compatibility redirect so old bookmarks cannot drift to another shell.
  @legacyAdmin path /admin.html
  redir @legacyAdmin /.admindev.html 308

  # Always revalidate application shells so every device sees the newest
  # release from the same URL. Static assets may be kept locally, but must be
  # revalidated by Caddy before reuse.
  @financeOld path /finance.html
  redir @financeOld https://finance.82.47.180.185.nip.io/ 302

  @freshShell path / /index.html /.admindev.html /manifest.webmanifest /sw.js /RELEASE
  header @freshShell Cache-Control "no-store, no-cache, must-revalidate"

  @appAssets path /src/*
  header @appAssets Cache-Control "no-cache, must-revalidate"

  @api path /api/*
  handle @api {
    reverse_proxy app:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

:80 {
  @financeHttp host finance.82.47.180.185.nip.io
  redir @financeHttp https://finance.82.47.180.185.nip.io{uri} 308
  import kitchen_site
}

82.47.180.185.nip.io {
  import kitchen_site
}

staging.82.47.180.185.nip.io {
  encode zstd gzip

  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Kitchen-Environment "staging"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy kitchen-os-staging-web:80
}

marketing.82.47.180.185.nip.io {
  encode zstd gzip

  reverse_proxy marketing-seo-platform:3000

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

# Standalone origin: do NOT expose inventory, restaurant users, admin, or business APIs.
finance.82.47.180.185.nip.io {
  encode zstd gzip
  @loginApi path /api/auth/login /api/auth/logout /api/auth/me
  handle @loginApi {
    reverse_proxy app:8080
  }
  handle /api/finance/* {
    reverse_proxy app:8080
  }
  handle / {
    redir /finance.html 302
  }
  handle /finance.html {
    root * /srv
    file_server
  }
  handle /src/personal-finance.js {
    root * /srv
    file_server
  }
  handle /src/personal-finance.css {
    root * /srv
    file_server
  }
  handle {
    respond "Not Found" 404
  }
  header {
    Cache-Control "no-store, no-cache, must-revalidate"
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
  }
}
