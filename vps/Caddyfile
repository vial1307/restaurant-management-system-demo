:80 {
  encode zstd gzip

  @freshFrontend path / /index.html /src/* /manifest.webmanifest /sw.js
  header @freshFrontend Cache-Control "no-store, no-cache, must-revalidate"

  @api path /api/*
  handle @api {
    reverse_proxy app:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
