(kitchen_site) {
  encode zstd gzip

  # The application has one canonical entry point. Old bookmarks continue to
  # work and keep their hash route, but the browser address becomes "/".
  @legacyEntry path /vps-entry.html
  redir @legacyEntry / 308

  # Always revalidate the application shell so every device sees the newest
  # release from the same URL. Static assets may be kept locally, but must be
  # revalidated by Caddy before reuse.
  @freshShell path / /index.html /manifest.webmanifest /sw.js /RELEASE
  header @freshShell Cache-Control "no-store, no-cache, must-revalidate"

  @appAssets path /src/*
  header @appAssets Cache-Control "no-cache, must-revalidate"

  @api path /api/*
  handle @api {
    reverse_proxy app:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

:80 {
  import kitchen_site
}

82.47.180.185.nip.io {
  import kitchen_site
}
